# ---------------------------------------------------------------
# Festiva AI - environment variables (placeholders only).
# Copy this file to `.env` for local development. NEVER commit `.env`.
# ---------------------------------------------------------------

# ===== API server (Express). Set these in Render in production. =====
NODE_ENV=development
PORT=8787

# Comma-separated list of browser origins allowed to call the API.
# Production: your exact Vercel URL, e.g. https://festiva-ai.vercel.app
CORS_ORIGINS=http://localhost:5173

# Supabase project (Project Settings -> API). The service-role key is a SECRET:
# it must only ever exist on the server, never in client code.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Google Gemini API key (https://aistudio.google.com/apikey). Server-side only.
GEMINI_API_KEY=replace-with-gemini-api-key
# Model is configuration, not code. Check https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.6-flash
# Per-request timeout for model calls, in milliseconds.
AI_TIMEOUT_MS=90000
# Optional: thinking effort (minimal | low | medium | high). Leave empty to use the provider default.
# Lower levels are faster and cheaper; try "low" if plans are slow or get cut off.
GEMINI_THINKING_LEVEL=

# ===== Web client (Vite). Set these in Vercel in production. =====
# Leave VITE_API_URL empty locally: Vite proxies /api to http://localhost:8787.
# Production: your Render URL, e.g. https://festiva-ai-api.onrender.com
VITE_API_URL=
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon key is public by design; Row Level Security protects the data.
VITE_SUPABASE_ANON_KEY=replace-with-anon-key
